{
  "name": "gleipnir-typescript",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/verify",
    "packages/sdk",
    "packages/hosted"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build -w @getgleipnir/verify && npm run build -w @getgleipnir/sdk",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "interop": "node scripts/interop.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:action": "node scripts/build-action.mjs"
  },
  "overrides": {
    "vite": "7.3.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
