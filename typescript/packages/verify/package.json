{
  "name": "@getgleipnir/verify",
  "version": "0.4.0",
  "description": "Offline verifier for Gleipnir agent action record bundles, and the KYA mandate checker (Node and browsers).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getgleipnir/gleipnir.git",
    "directory": "typescript/packages/verify"
  },
  "homepage": "https://getgleipnir.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mandate": {
      "types": "./dist/mandate.d.ts",
      "import": "./dist/mandate.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "gleipnir-verify": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.3"
  }
}
